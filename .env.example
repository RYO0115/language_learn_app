# ── AI プロバイダー設定 ──────────────────────────────────────
# 使用する AI プロバイダーを選択: "claude" または "gemini"
AI_PROVIDER=gemini

# ── Anthropic (Claude) API ──────────────────────────────────
# AI_PROVIDER=claude の場合に必要
# 取得先: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google (Gemini) API ─────────────────────────────────────
# AI_PROVIDER=gemini の場合に必要（無料枠あり・クレジットカード不要）
# 取得先: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
# 使用するモデル（無料枠対応モデル例: gemini-2.0-flash / gemini-2.5-flash）
GEMINI_MODEL=gemini-2.0-flash

# ── アプリ設定 ───────────────────────────────────────────────
APP_NAME=Language Learn App
DEBUG=false
DATABASE_URL=sqlite:///./data/language_learn.db

# ── クイズ設定 ───────────────────────────────────────────────
QUIZ_QUESTION_COUNT=20
